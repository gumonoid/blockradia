FROM node:22-alpine
WORKDIR /app
COPY package.json package.json
COPY bot/ bot/
COPY lib/ lib/
COPY LICENSE LICENSE
COPY docs/AML_DATA_LICENSES.md docs/AML_DATA_LICENSES.md
COPY docs/THIRD_PARTY_NOTICES.md docs/THIRD_PARTY_NOTICES.md
RUN mkdir -p /app/work && chown node:node /app/work
USER node
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
CMD ["node", "--experimental-strip-types", "bot/start.mjs"]
